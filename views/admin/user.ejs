<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - EchoBoard</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
        crossorigin="anonymous">
</head>
<body class="bg-light">
    <div class="container py-4">
        <form id="user-form">
            <input type="hidden" name="userId" value="<%= user.id %>">

            <div class="card shadow">
                <div class="card-header">
                    <h4 class="mb-0">
                        유저 관리
                    </h4>
                </div>

                <div class="card-body">
                    <div class="row g-3">

                        <div class="col-md-6">
                            <label class="form-label">아이디</label>
                            <input
                                class="form-control"
                                value="<%= user.username %>"
                                readonly>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">닉네임</label>
                            <input
                                class="form-control"
                                name="nickname"
                                data-default="<%= user.nickname ?? "" %>"
                                value="<%= user.nickname ?? "" %>">
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">이메일</label>
                            <input
                                class="form-control"
                                type="email"
                                value="<%= user.email %>"
                                data-default="<%= user.email %>"
                                name="email">
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">권한</label>

                            <select class="form-select" name="role" data-default="<%= user.role %>">
                                <option
                                    value="USER"
                                    <%= user.role === "USER" ? "selected" : "" %>>
                                    USER
                                </option>

                                <option
                                    value="ADMIN"
                                    <%= user.role === "ADMIN" ? "selected" : "" %>>
                                    ADMIN
                                </option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">가입일</label>
                            <input
                                class="form-control"
                                value="<%= Format(user.createdAt) %>"
                                readonly>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">새 비밀번호</label>
                            <input
                                class="form-control"
                                type="password"
                                name="password"
                                placeholder="변경하지 않으려면 비워두세요">
                        </div>

                        <div class="col-12">
                            <label class="form-label">정지 사유</label>

                            <input
                                class="form-control"
                                name="banReason"
                                data-default="<%= user.banReason ?? "" %>"
                                value="<%= user.banReason ?? "" %>">
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">정지 해제일</label>

                            <input
                                class="form-control"
                                type="datetime-local"
                                name="bannedUntil"
                                data-default="<%= user.bannedUntil ? ToDateTimeLocal(user.bannedUntil) : "" %>"
                                value="<%= user.bannedUntil ? ToDateTimeLocal(user.bannedUntil) : "" %>">
                        </div>

                        <div class="col-md-6 d-flex align-items-end">
                            <div class="form-check">
                                <input
                                    class="form-check-input"
                                    id="twoFactorEnabled"
                                    type="checkbox"
                                    name="twoFactorEnabled"
                                    data-default="<%= user.twoFactorEnabled %>"
                                    <%= user.twoFactorEnabled ? "checked" : "disabled" %>>

                                <label
                                    class="form-check-label"
                                    for="twoFactorEnabled">
                                    2단계 인증 사용
                                </label>
                            </div>
                        </div>

                    </div>
                </div>

                <div class="card-footer d-flex justify-content-between">
                    <button
                        class="btn btn-danger"
                        type="button">
                        계정 탈퇴
                    </button>

                    <div>
                        <button
                            class="btn btn-secondary"
                            type="button"
                            onclick="window.close()">
                            닫기
                        </button>

                        <button
                            class="btn btn-primary"
                            type="submit">
                            저장
                        </button>
                    </div>
                </div>
            </div>
        </form>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
</body>
</html>
<script>
const userForm = document.getElementById("user-form");

userForm.addEventListener("submit", async e => {
    e.preventDefault();
    const formData = new FormData(userForm);

    const userId = formData.get("userId")?.toString().trim();
    const body = {}
        
    for (const element of userForm.elements) {
        if (!element.name) continue;

        if (!element.hasAttribute("data-default")) continue;

        let currentValue;
        let defaultValue;

        if (element.type === "checkbox") {
            currentValue = element.checked;
            defaultValue = element.dataset.default === "true";
        } else {
            currentValue = element.value;
            defaultValue = element.dataset.default;
        }

        if (currentValue !== defaultValue) {
            body[element.name] = currentValue;
        }
    }

    if (formData.get("password")) {
        body.password = formData.get("password").toString().trim();
    }

    try {
        const res = await fetch(`/api/users/${userId}`, {
            method: "PATCH",
            headers: {
                "Content-Type": "application/json"
            }, 
            body: JSON.stringify(body)
        });

        if (!res.ok) {
            const data = await res.json();
            return alert(data.message);
        }

        alert("변경되었습니다.");
        return location.reload();
    } catch {
        return alert("인터넷 연결 상태를 확인해주세요.");
    }
});
</script>