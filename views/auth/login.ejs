<div class="flex-grow-1 d-flex justify-content-center align-items-center mt-5">
    <div class="card p-4 shadow" style="width: 400px;">
        <h2 class="text-center mb-4">로그인</h2>

        <form id="login-form">
            <input class="form-control mb-3" type="text" name="username" placeholder="아이디">
            <input class="form-control mb-3" type="password" name="password" placeholder="비밀번호">

            <button type="submit" class="btn btn-primary w-100">로그인</button>
        </form>

        <div class="text-center mt-3">
            <span class="text-muted">계정이 없으신가요?</span>
            <a href="/register" class="text-decoration-none ms-1">회원가입</a>
        </div>
    </div>
</div>

<%- include("../components/turnstile.ejs") %>
<script src="/public/js/login.js"></script>