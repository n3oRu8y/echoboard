<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">

            <div class="card shadow-sm">

                <div class="card-body">

                    <h2 class="card-title text-center mb-4">
                        2단계 인증
                    </h2>

                    <p class="text-muted text-center mb-4">
                        인증 앱에 표시된 6자리 코드를 입력하세요.
                    </p>


                    <div id="error-message" class="alert alert-danger d-none"></div>

                    <form id="two-fa-verify-form">
                        <div class="mb-3">
                            <label class="form-label">
                                인증 코드
                            </label>

                            <input
                                type="text"
                                class="form-control text-center fs-4"
                                name="token"
                                maxlength="6"
                                pattern="[0-9]{6}"
                                inputmode="numeric"
                                autocomplete="one-time-code"
                                placeholder="000000"
                                required
                            >
                        </div>

                        <div class="form-check mb-3">

                            <input
                                class="form-check-input"
                                type="checkbox"
                                name="trustDevice"
                                id="trust-device"
                            >

                            <label class="form-check-label" for="trust-device">이 기기에서 30일간 인증 생략</label>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">인증하기</button>
                    </form>

                    <a href="/login" class="btn btn-outline-secondary w-100 mt-3">로그인 화면으로 돌아가기</a>
                </div>

            </div>

        </div>
    </div>
</div>
<script src="/public/js/2fa.js"></script>