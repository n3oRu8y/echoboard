<div class="row g-4">
    <% boards.forEach(board => { %>
        <div class="col-12 col-md-6">
            <div class="card h-100" style="min-height:420px;">
                <div class="card-header fw-bold"><a href="/boards/<%= board.url %>" class="list-group-item"><%= board.name %></a></div>
                <div class="list-group list-group-flush">
                    <% if(board.posts) { %>
                        <% board.posts.forEach(post => { %>
                            <a href="/boards/<%= board.url %>/<%= post.id %>" class="list-group-item list-group-item-action d-flex justify-content-between">
                                <span class="flex-grow-1 text-truncate">
                                    <% if (post.isNotice) { %>
                                        <span class="badge bg-danger ms-1">공지</span>
                                    <% } %>
                                    <%= post.title %>
                                </span>
                                <small class="text-nowrap ms-3" style="width: 60px; text-align: center;">
                                    <%= post.isAnonymous ? "익명" : post.author.nickname %>
                                </small>

                                <small class="text-nowrap ms-3" style="width: 90px; text-align: right;">
                                    <%= format(post.createdAt) %>
                                </small>
                            </a>
                        <% }); %>
                    <% } else { %>
                        <p class="list-group-item list-group-item-action d-flex justify-content-between">작성된 게시글이 없습니다.</p>
                    <% } %>
                </div>
            </div>
        </div>
    <% }); %>
</div>