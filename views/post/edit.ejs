<link rel="stylesheet" href="https://uicdn.toast.com/editor/latest/toastui-editor.min.css">

<div class="container py-5" style="max-width: 900px;">
    <div class="card shadow-sm">
        <div class="card-body">
            <h2 class="card-title mb-4">게시글 수정</h2>

            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" id="is-anonymous" checked>
                <label class="form-check-label" for="is-anonymous">
                    익명으로 작성
                </label>
            </div>

            <% if (user.role == "ADMIN") { %>
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" id="is-notice" <% if (post.isNotice) { %>checked<% } %>>
                    <label class="form-check-label" for="is-notice">
                        공지사항
                    </label>
                </div>
            <% } %>

            <div class="mb-4">
                <input
                    id="title"
                    type="text"
                    class="form-control"
                    placeholder="제목을 입력하세요"
                    value="<%= post.title %>"
                    >
            </div>

            <div class="mb-4">
                <div id="editor"></div>
            </div>

            <div class="mb-4">
                <label for="attachment" class="form-label fw-semibold">
                    첨부파일
                </label>
                <input
                    type="file"
                    id="attachment"
                    class="form-control">
            </div>

            <ul id="uploaded" class="list-group mb-4"></ul>

            <div class="d-grid">
                <button
                    id="submit"
                    class="btn btn-primary btn-lg">
                    게시글 수정
                </button>
            </div>
        </div>
    </div>
</div>

<%- include("../components/turnstile.ejs") %>

<script src="https://uicdn.toast.com/editor/latest/toastui-editor-all.min.js"></script>
<script type="application/json" id="edit-data"><%- JSON.stringify({ postContent: post.content, attachments, images }).replace(/</g, "\\u003c") %></script>
<script>
const segments = window.location.pathname
    .split("/")
    .filter(Boolean);

const boardId = segments[1];

const { postContent, attachments, images } = JSON.parse(
    document.querySelector("#edit-data").textContent
);

for(const attachment of attachments) {
    addAttachment(attachment);
}

const editor = new toastui.Editor({
    el: document.querySelector("#editor"),
    height: "500px",
    initialEditType: "wysiwyg",
    initialValue: postContent
});

// 첨부파일 목록 표시
function addAttachment(attachment) {
    const li = document.createElement("li");
    li.className = "list-group-item d-flex justify-content-between align-items-center";

    const name = document.createElement("span");
    name.textContent = attachment.originalName ?? attachment.fileName;

    const remove = document.createElement("button");
    remove.type = "button";
    remove.className = "btn btn-sm btn-outline-danger";
    remove.innerHTML = '삭제';

    remove.onclick = () => {
        const index = attachments.findIndex(v => v.id === attachment.id);

        if (index !== -1)
            attachments.splice(index, 1);

        li.remove();
    };

    li.appendChild(name);
    li.appendChild(remove);

    document.getElementById("uploaded").appendChild(li);
}

// 에디터 이미지 업로드
editor.removeHook("addImageBlobHook");

editor.addHook("addImageBlobHook", async (blob, callback) => {
    const token = await RenderTurnstile();
    if (!token) {
        return;
    }

    const formData = new FormData();
    formData.append("image", blob);
    formData.append("token", token);

    const res = await fetch("/api/attachments/image", {
        method: "POST",
        body: formData
    });

    if (!res.ok) {
        alert("이미지 업로드 실패");
        return;
    }

    const attachment = await res.json();

    // 본문 이미지도 첨부파일로 관리하려면 유지
    images.push(attachment.data);

    callback(attachment.data.url, attachment.data.originalName);
});

// 일반 첨부파일 자동 업로드
document.getElementById("attachment").addEventListener("change", async (e) => {
    const token = await RenderTurnstile();
    if (!token) {
        return;
    }

    const file = e.target.files[0];

    if (!file)
        return;

    const formData = new FormData();
    formData.append("file", file);
    formData.append("token", token);

    const res = await fetch("/api/attachments/file", {
        method: "POST",
        body: formData
    });

    if (!res.ok) {
        alert("파일 업로드 실패");
        return;
    }

    const attachment = await res.json();

    attachments.push(attachment.data);

    addAttachment(attachment.data);

    e.target.value = "";
});

// 게시글 수정
document.getElementById("submit").addEventListener("click", async () => {
    const token = await RenderTurnstile();
    if (!token) {
        return;
    }
    
    if (attachments.length > 5) return alert("파일 첨부는 5개까지 가능합니다.");

    const body = {
        title: document.getElementById("title").value,
        content: editor.getHTML(),
        attachmentIds: attachments.map(v => v.id),
        imageIds: images.map(v => v.id),
        isAnonymous: document.getElementById("is-anonymous").checked,
        token: token,
        isNotice: document.getElementById("is-notice").checked,
    };

    console.log(body);

    const res = await fetch(`/api/boards/${boardId}/posts/<%= post.id %>`, {
        method: "PATCH",
        headers: {
            "Content-Type": "application/json"
        },
        body: JSON.stringify(body)
    });

    if (!res.ok) {
        const data = await res.json();
        alert(data.message);
        return;
    }

    const result = await res.json();

    console.log(result);

    alert("게시글 수정 완료");
    location.href = "/boards/<%= post.board.url %>/<%= post.id %>";
});
</script>

</body>
</html>
