<link rel="stylesheet" href="https://uicdn.toast.com/editor/latest/toastui-editor.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
<script src="https://uicdn.toast.com/editor/latest/toastui-editor-all.min.js"></script>

<%
    const myReaction = post.reactions.find(
        reaction => reaction.userId === user?.id
    );

    const likeCount = post.reactions.filter(reaction => reaction.type == 1).length;
    const dislikeCount = post.reactions.filter(reaction => reaction.type == 0).length;
%>

<div class="card shadow-sm mb-4">
    <div class="card-body">

        <h2 class="mb-3"><%= post.title %></h2>

        <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-4">
            <div>
                <strong><%= post.isAnonymous ? "익명" : post.author.nickname %><% if (user?.role == "ADMIN" && post.isAnonymous) { %>(<%= post.author.username %>)%><% } %></strong>

                <% if (post.author.role == "ADMIN" && !post.isAnonymous) { %>
                    <span class="badge bg-danger ms-1">관리자</span>
                <% } %>
            </div>

            <small class="text-muted">
                <%= DateFormat(post.createdAt) %>
            </small>
        </div>

        <div class="post-content rounded p-3 mb-4 overflow-hidden" style="min-height: 300px;">
            <%- post.content %>
        </div>

        <% if (post.attachments.length > 0) { %>
            <div class="border-top pt-4">
                <h6 class="mb-3">
                    첨부파일
                    <span class="text-secondary">(<%= post.attachments.filter(attachment => !attachment.isImage).length %>)</span>
                </h6>

                <div class="list-group">
                    <% post.attachments.forEach(attachment => { %>
                        <% if (!attachment.isImage) { %>
                            <a
                                href="/api/attachments/<%= attachment.id %>"
                                class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">

                                <span>
                                    <i class="bi bi-paperclip me-2"></i>
                                    <%= attachment.fileName %>
                                </span>

                                <span class="badge bg-secondary">
                                    다운로드
                                </span>
                            </a>
                        <% } %>
                    <% }); %>
                </div>
            </div>
        <% } %>

        <div class="d-flex justify-content-between align-items-center mt-4">
            <a href="/boards/<%= post.board.url %>" class="btn btn-outline-secondary">
                ← 목록으로
            </a>

            <div>
                <% if (post.author.id == user?.id) { %>
                    <a href="/boards/<%= post.board.url %>/<%= post.id %>/edit" class="btn btn-outline-primary">
                        수정
                    </a>
                <% } %>

                <% if (post.author.id == user?.id || user?.role == "ADMIN") { %>
                    <button id="deleteBtn" class="btn btn-outline-danger">
                        삭제
                    </button>
                <% } %>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-center gap-3 mb-4">
        <button
            id="reaction-btn"
            class="btn <%= myReaction?.type == 1 ? 'btn-success' : 'btn-outline-success' %>"
            data-reaction="LIKE">

            <i class="bi bi-hand-thumbs-up"></i>
            <span class="ms-1">좋아요</span>

            <% if (typeof likeCount !== "undefined") { %>
                <span class="badge bg-light text-dark ms-2">
                    <%= likeCount %>
                </span>
            <% } %>
        </button>

        <button
            id="reaction-btn"
            class="btn <%= myReaction?.type == 0 ? 'btn-danger' : 'btn-outline-danger' %>"
            data-reaction="DISLIKE">

            <i class="bi bi-hand-thumbs-down"></i>
            <span class="ms-1">싫어요</span>

            <% if (typeof dislikeCount !== "undefined") { %>
                <span class="badge bg-light text-dark ms-2">
                    <%= dislikeCount %>
                </span>
            <% } %>
        </button>
    </div>
</div>

<% if (user) { %>
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h5 class="card-title mb-3">댓글 작성</h5>

            <form id="comment-form">
                <textarea
                    class="form-control mb-3"
                    name="content"
                    rows="3"
                    placeholder="댓글을 입력하세요."
                    required></textarea>

                <div class="d-flex justify-content-end align-items-center gap-3">
                    <div class="form-check mb-0">
                        <input
                            class="form-check-input"
                            type="checkbox"
                            id="comment-anonymous"
                            name="anonymous"
                            checked>
                        <label class="form-check-label" for="comment-anonymous">
                            익명으로 작성
                        </label>
                    </div>

                    <button type="submit" class="btn btn-primary">
                        댓글 작성
                    </button>
                </div>
            </form>
        </div>
    </div>
<% } %>

<div class="list-group">
    <% if (post.comments.length > 0) { %>
        <% post.comments.forEach(comment => { %>
            <% if (!comment.deletedAt) { %>
                <div class="list-group-item py-3">
                    <div class="d-flex justify-content-between">
                        <div>
                            <div><strong><%= comment.displayNick %></strong> <% if (!post.isAnonymous && !comment.isAnonymous && post.authorId == comment.authorId) { %><span class="badge bg-primary">작성자</span><% } %></div>
                            <div class="text-muted small"><%= DateFormat(comment.createdAt) %></div>
                        </div>
                        <div>
                            <% if (user) { %>
                                <button class="btn btn-sm btn-outline-secondary reply-btn" data-comment-id="<%= comment.id %>">답글</button>
                                <% if (comment.author.id == user?.id) { %>
                                    <button id="delete-comment-btn" class="btn btn-sm btn-outline-danger" data-comment-id="<%= comment.id %>">삭제</button>
                                <% } %>
                            <% } %>
                        </div>
                    </div>
                    <p class="mt-3 mb-3"><%= comment.content %></p>

                    <% if (comment.replies.length > 0) { %>
                        <div class="replies ms-4 border-start ps-3">
                            <% comment.replies.forEach(reply => { %>
                                <% if (!reply.deletedAt) { %>
                                    <div class="pb-3 border-bottom">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div>
                                                <strong><%= reply.displayNick %></strong>
                                                <% if (!post.isAnonymous && !reply.isAnonymous && reply.authorId == post.authorId) { %>
                                                    <span class="badge bg-primary">작성자</span>
                                                <% } %>
                                                <span class="text-muted small"><%= DateFormat(reply.createdAt) %></span>
                                            </div>

                                            <% if (reply.author.id == user?.id) { %>
                                                <button id="delete-comment-btn" class="btn btn-sm btn-outline-danger" data-comment-id="<%= reply.id %>">삭제</button>
                                            <% } %>
                                        </div>

                                        <p class="mt-1 mb-0"><%= reply.content %></p>
                                    </div>
                                <% } %>
                            <% }); %>
                        </div>
                    <% } %>
                </div>
            <% } %>
        <% }); %>
    <% } else { %>
        <div class="list-group-item py-3">
            <div class="d-flex justify-content-between">
                <div>
                    <p>작성된 댓글이 없습니다.</p>
                </div>
            </div>
        </div>
    <% } %>
</div>

<div id="reply-editor" class="card shadow-sm mt-3 d-none">
    <div class="card-body">
        <form id="reply-form">
            <input type="hidden" name="commentId">

            <textarea class="form-control mb-3" rows="2" name="content" placeholder="답글을 입력하세요."></textarea>

            <div class="d-flex justify-content-end align-items-center gap-3">
                <div class="form-check mb-0">
                    <input class="form-check-input" type="checkbox" id="reply-anonymous" name="anonymous" checked>
                    <label class="form-check-label" for="reply-anonymous">익명으로 작성</label>
                </div>

                <button type="button" class="btn btn-outline-secondary" id="reply-cancel">취소</button>
                <button type="submit" class="btn btn-primary">답글 작성</button>
            </div>
        </form>
    </div>
</div>

<script>
    const boardUrl = "<%= post.board.url %>";
    const postId = "<%= post.id %>";
</script>
<script src="/public/js/post.js"></script>