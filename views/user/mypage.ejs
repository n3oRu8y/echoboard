<div class="container mt-5">
    <div class="card shadow p-4 mx-auto" style="max-width: 600px;">
        <h2 class="text-center mb-4">마이페이지</h2>

        <div class="mb-4">
            <h5 class="border-bottom pb-2">기본 정보</h5>

            <div class="mb-2">
                <span class="text-muted">아이디</span>
                <span class="float-end"><%= user.username %></span>
            </div>

            <div class="mb-2">
                <span class="text-muted">닉네임</span>
                <span class="float-end"><%= user.nickname %></span>
            </div>

            <div class="d-grid mb-2">
                <a href="/mypage/nickname" class="btn btn-outline-primary">
                    닉네임 변경
                </a>
            </div>

            <div class="mb-2">
                <span class="text-muted">이메일</span>
                <span class="float-end"><%= user.email %></span>
            </div>

            <div>
                <span class="text-muted">가입일</span>
                <span class="float-end"><%= Format(user.createdAt) %></span>
            </div>
        </div>

        <div class="mb-4">
            <h5 class="border-bottom pb-2">활동 내역</h5>

            <div class="d-flex justify-content-between mb-2">
                <span>작성한 게시글</span>
                <a href="/mypage/posts" class="text-decoration-none">
                    <%= user.posts.length %>개
                </a>
            </div>

            <div class="d-flex justify-content-between">
                <span>작성한 댓글</span>
                <a href="/mypage/comments" class="text-decoration-none">
                    <%= user.comments.length %>개
                </a>
            </div>
        </div>

        <div class="mb-4">
            <h5 class="border-bottom pb-2">보안 설정</h5>

            <div class="d-grid gap-2">
                <a href="/mypage/password" class="btn btn-outline-primary">
                    비밀번호 변경
                </a>

                <a href="/mypage/2fa" class="btn btn-outline-primary">
                    2차 인증 설정
                </a>
            </div>
        </div>

        <div>
            <h5 class="border-bottom pb-2">계정 관리</h5>

            <div class="d-grid gap-2">
                <button id="btn-logout" class="btn btn-outline-secondary">
                    로그아웃
                </button>

                <a class="btn btn-outline-danger" href="/mypage/withdraw">
                    회원 탈퇴
                </a>
            </div>
        </div>
    </div>
</div>
<script src="/public/js/mypage.js"></script>